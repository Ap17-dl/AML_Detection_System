# Supabase project settings — Project Settings > API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by SQLAlchemy/Alembic (Supabase connection pooler, SSL required).
# Example: postgresql+asyncpg://postgres:<password>@<host>:5432/postgres?ssl=require
DATABASE_URL=

# CORS: comma-separated list of allowed frontend origins.
CORS_ALLOW_ORIGINS=http://localhost:3000
